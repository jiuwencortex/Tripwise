# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# JiuwenClaw WebSocket
JIUWENCLAW_WS_URL=ws://localhost:19000/ws
WS_TIMEOUT=1800
# Chat mode: agent.plan (Planning), agent.fast (Performance), team (Cluster), code.plan, code.normal
DEFAULT_JIUWENCLAW_MODE=agent.plan

# OpenClaw WebSocket Gateway (default port 18789)
# The gateway must be running first: `npx openclaw` or run the OpenClaw app
OPENCLAW_WS_URL=ws://localhost:18789/ws

# Authentication: Leave blank if gateway auth is disabled, or provide your token
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Session Key: Format is "agent:<agentId>:<channelId>" or "main" for default
# Examples: agent:main:main, agent:travel-expert:tripwise, main
OPENCLAW_SESSION_KEY=agent:main:main

# Optional: Specific agent to route to (can be overridden per request)
# Leave blank to use the default agent configured in your OpenClaw gateway
# Examples: travel-expert, itinerary-planner, flight-specialist
OPENCLAW_AGENT_ID=

# Optional: Model override (can be overridden per request)
# Leave blank to use the agent's default model
# Format: provider/model
# Examples: anthropic/claude-sonnet-4.5, anthropic/claude-opus-4.6, openai/gpt-4.5-turbo
OPENCLAW_MODEL=

# OpenJiuwen REST API
OPENJIUWEN_URL=http://localhost:8080/agents/execute
OPENJIUWEN_AGENT_ID=react_agent_id
OPENJIUWEN_CONV_ID=tripwise_demo_id

# Server
PORT=3025

# Default result counts per planning step (user can override in Settings UI)
DEFAULT_NUM_DESTINATIONS=2
DEFAULT_NUM_FLIGHTS=2
DEFAULT_NUM_HOTELS=2
DEFAULT_NUM_CAR_RENTALS=2
DEFAULT_NUM_ATTRACTIONS=2

# UI options
SHOW_AGENT_TIMER=true

# Server bind host: 0.0.0.0 (all interfaces, default) or 127.0.0.1 (localhost only)
HOST=0.0.0.0
PORT=3025
