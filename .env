# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# JiuwenClaw WebSocket
JIUWENCLAW_WS_URL=ws://localhost:19000/ws
WS_TIMEOUT=12000

# OpenJiuwen REST API
OPENJIUWEN_URL=http://localhost:8080/agents/execute
OPENJIUWEN_AGENT_ID=a58796e2-a6e2-40ef-b3ed-3d2e11175eb1
OPENJIUWEN_CONV_ID=tripwise_demo_id

# Server
PORT=3025

# Result counts per planning step (default: 2)
NUM_DESTINATIONS=2
NUM_FLIGHTS=2
NUM_HOTELS=2
NUM_CAR_RENTALS=2
NUM_ATTRACTIONS=2

# UI options
SHOW_AGENT_TIMER=true
